msgid "Pause when maximized window"
msgstr "窗口最大化时暂停"

#: src/assets/control.ui
msgid "Automatically mutes playback when maximized window or full screen mode is detected"
msgstr "检测到窗口最大化或全屏时自动静音"

#: src/assets/control.ui
msgid "Mute when maximized window"
msgstr "窗口最大化时静音"

#: src/assets/control.ui
msgid "Volume control"
msgstr "音量控制"

#: src/assets/control.ui
msgid "Static wallpaper blur radius"
msgstr "静态壁纸模糊半径"

#: src/assets/control.ui
msgid "0"
msgstr "0"

#: src/assets/control.ui
msgid "Open config file"
msgstr "打开配置文件"

#: src/assets/control.ui
msgid "About Hidamari"
msgstr "关于 Hidamari"

#: src/assets/control.ui
msgid "Quit Hidamari"
msgstr "退出 Hidamari"

#. === control.ui - Local Video Tab ===
#: src/assets/control.ui
msgid ""
"<span size=\"x-large\"><b>Local Video</b></span>\n"
"Videos located in Hidamari folder"
msgstr ""
"<span size=\"x-large\"><b>本地视频</b></span>\n"
"Hidamari 文件夹中的视频"

#: src/assets/control.ui
msgid "Refresh"
msgstr "刷新"

#: src/assets/control.ui
msgid "Open Hidamari folder"
msgstr "打开 Hidamari 文件夹"

#: src/assets/control.ui
msgid "Local Video"
msgstr "本地视频"

#: src/assets/control.ui
msgid "Apply"
msgstr "应用"

#. === control.ui - Streaming Tab ===
#: src/assets/control.ui
msgid ""
"<span size=\"x-large\"><b>Streaming</b></span>\n"
"Videos from streaming services"
msgstr ""
"<span size=\"x-large\"><b>在线串流</b></span>\n"
"来自流媒体服务的视频"

#: src/assets/control.ui
msgid "<b>Streaming URL</b>"
msgstr "<b>串流地址</b>"

#: src/assets/control.ui
msgid "https://www.youtube.com/watch?v=id"
msgstr "https://www.youtube.com/watch?v=id"

#: src/assets/control.ui
msgid "💡\tThis feature uses <i>yt-dlp</i> as backend"
msgstr "💡\t此功能使用 <i>yt-dlp</i> 作为后端"

#: src/assets/control.ui
msgid ""
"😉\tTry playing any YouTube video! <a href=\"https://github.com/yt-dlp/yt-dlp/"
"blob/master/supportedsites.md\">Supported sites (yt-dlp)</a>"
msgstr ""
"😉\t试试播放任意 YouTube 视频！<a href=\"https://github.com/yt-dlp/yt-dlp/"
"blob/master/supportedsites.md\">支持的网站 (yt-dlp)</a>"

#: src/assets/control.ui
msgid "Hint"
msgstr "提示"

#: src/assets/control.ui
msgid "Streaming"
msgstr "在线串流"

#. === control.ui - Web Page Tab ===
#: src/assets/control.ui
msgid ""
"<span size=\"x-large\"><b>Web Page</b></span>\n"
"Set a web page as wallpaper"
msgstr ""
"<span size=\"x-large\"><b>网页</b></span>\n"
"将网页设为壁纸"

