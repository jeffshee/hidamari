#. === control.ui - Popover Main Menu ===
#: src/assets/control.ui
msgid "Quick toggles"
msgstr "快捷开关"

#: src/assets/control.ui
msgid "Autostart after login"
msgstr "登录后自动启动"

#: src/assets/control.ui
msgid "Video frame can be applied as system wallpaper, look great in GNOME"
msgstr "可将视频帧设为系统壁纸，在 GNOME 下效果最佳"

#: src/assets/control.ui
msgid "Apply static wallpaper"
msgstr "应用静态壁纸"

#: src/assets/control.ui
