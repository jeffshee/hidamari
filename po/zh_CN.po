#. === AppData ===
#: data/io.github.jeffshee.Hidamari.appdata.xml.in
msgid "Video wallpaper for Linux"
msgstr "Linux 视频壁纸"

#: data/io.github.jeffshee.Hidamari.appdata.xml.in
msgid ""
"Video wallpaper for Linux. Written in Python. 🐍\n"
"\n"
"Hidamari 日溜まり 【ひだまり】 (n) sunny spot; exposure to the sun"
msgstr ""
"Linux 视频壁纸，Python 编写 🐍\n"
"\n"
"Hidamari 日溜まり【ひだまり】(名词) 阳光照耀的地方"

#: data/io.github.jeffshee.Hidamari.appdata.xml.in
msgid "Similar functionality to Xwinwrap + mpv or Komorebi, with more features."
msgstr "功能类似于 Xwinwrap + mpv 或 Komorebi，但特性更丰富。"

